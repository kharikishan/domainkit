{
  "name": "domainkit",
  "version": "0.2.0",
  "description": "CLI and MCP server for managing domain-focused Agent Skills",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "domainkit": "./dist/cli.js",
    "dk": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "templates",
    "schemas"
  ],
  "scripts": {
    "build": "tsup && mkdir -p schemas && cp src/schemas/*.json schemas/",
    "dev": "tsup --watch",
    "setup": "pnpm install && pnpm run build && pnpm link --global",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "inquirer": "^12.4.2",
    "js-yaml": "^4.1.0",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.0.1",
    "ajv": "^8.17.1",
    "gpt-tokenizer": "^2.8.1",
    "handlebars": "^4.7.8",
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "gray-matter": "^4.0.3",
    "cli-table3": "^0.6.5"
  },
  "optionalDependencies": {
    "ts-morph": "^25.0.0",
    "natural": "^8.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "tsup": "^8.4.0",
    "vitest": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@types/node": "^22.13.10",
    "@types/js-yaml": "^4.0.9",
    "@types/inquirer": "^9.0.7",
    "@types/natural": "^5.1.5",
    "@types/minimatch": "^5.1.2",
    "ts-morph": "^25.0.0",
    "natural": "^8.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "keywords": [
    "domainkit",
    "agent-skills",
    "domain-knowledge",
    "cli",
    "mcp",
    "ai",
    "coding-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kharikishan/domainkit.git"
  }
}
